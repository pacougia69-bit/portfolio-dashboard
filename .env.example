# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# JWT Secret for Authentication
JWT_SECRET=your-secret-key-here

# OpenAI API Key for AI Features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Twelve Data API Key for Live Stock Prices (Optional)
# Get your key from: https://twelvedata.com/
TWELVE_DATA_API_KEY=your-twelvedata-key

# OAuth Configuration (for Railway deployment)
OAUTH_SERVER_URL=https://your-app.up.railway.app
VITE_OAUTH_PORTAL_URL=https://your-app.up.railway.app
VITE_APP_ID=demo-app

# Public URL for media uploads and external API access
# Railway automatically sets RAILWAY_STATIC_URL and RAILWAY_PUBLIC_DOMAIN
# You can override with PUBLIC_URL if needed
# Priority: PUBLIC_URL > RAILWAY_STATIC_URL > RAILWAY_PUBLIC_DOMAIN > OAUTH_SERVER_URL > localhost
PUBLIC_URL=https://your-app.up.railway.app

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# App Configuration
VITE_APP_TITLE=Portfolio Dashboard
PORT=3000
NODE_ENV=development
